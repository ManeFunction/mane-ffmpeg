<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ManeFfmpeg.App.ViewModels"
        x:Class="ManeFfmpeg.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="640" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/app.ico">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="FFMPEG" Classes="title" />
        <Border Classes="panel" Padding="10">
            <SelectableTextBlock Text="{Binding FfmpegStatus}" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,6,Auto">
            <TextBlock Text="ffmpeg path" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding FfmpegPath}" PlaceholderText="automatic (PATH, Homebrew, /usr/bin…)" />
            <TextBlock Grid.Row="2" Text="ffprobe path" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FfprobePath}" PlaceholderText="automatic (next to ffmpeg)" />
        </Grid>

        <TextBlock Text="PREVIEW (LIBMPV)" Classes="title" Margin="0,8,0,0" />
        <Border Classes="panel" Padding="10">
            <SelectableTextBlock Text="{Binding MpvStatus}" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <Grid ColumnDefinitions="110,*">
            <TextBlock Text="libmpv path" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LibMpvPath}" PlaceholderText="automatic (Homebrew, MacPorts, IINA, system)" />
        </Grid>
        <CheckBox Content="Hardware video decoding for preview" IsChecked="{Binding HardwareDecoding}" />

        <TextBlock Text="GENERAL" Classes="title" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox Content="System notification when an export ends" IsChecked="{Binding Notifications}" />
            <Button Content="Test" Command="{Binding TestNotificationCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="120" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <Button Content="Install Missing Components…" Click="OnInstallClicked" IsVisible="{Binding CanInstall}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Close" Click="OnCloseClicked" />
                <Button Content="Apply" Classes="accent" Command="{Binding ApplyCommand}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
