<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ManeFfmpeg.UI.ViewModels"
        x:Class="ManeFfmpeg.UI.Views.QuickConvertWindow"
        x:DataType="vm:QuickConvertViewModel"
        Title="Mane FFmpeg" Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico">
    <Window.Styles>
        <Style Selector="SelectableTextBlock.status">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="{Binding Heading}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding FileText}" Classes="dim" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding FileText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding !HasErrors}" />
        <TextBlock Text="{Binding ProgressText}" FontSize="12" Classes="dim"
                   IsVisible="{Binding ProgressText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <SelectableTextBlock Classes="status" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"
                             IsVisible="{Binding HasErrors}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Show in Finder" Command="{Binding RevealCommand}" IsVisible="{Binding HasErrors}" />
            <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" IsVisible="{Binding IsRunning}"
                    MinWidth="90" HorizontalContentAlignment="Center" />
            <Button Content="{Binding ButtonText}" Command="{Binding CancelOrCloseCommand}"
                    MinWidth="90" HorizontalContentAlignment="Center" />
        </StackPanel>
    </StackPanel>
</Window>
