<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ManeFfmpeg.UI.ViewModels"
        xmlns:model="using:ManeFfmpeg.Core.Model"
        x:Class="ManeFfmpeg.UI.Views.PresetsWindow"
        x:DataType="vm:PresetsViewModel"
        Title="Export Presets" Width="860" Height="600" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" Icon="/Assets/app.ico">
    <Window.Styles>
        <Style Selector="Button.save TextBlock.saved">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.save:disabled TextBlock.saved">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.save:disabled TextBlock.unsaved">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TabStrip.kinds TabStripItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="4,0,12,0" />
        </Style>
        <Style Selector="Button.move">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.move PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="12">
        <!-- Video presets feed the Export button, audio presets its Extract audio mode. -->
        <TabStrip x:Name="KindTabs" Classes="kinds" DockPanel.Dock="Top" Margin="0,0,0,10" SelectedIndex="{Binding KindIndex}">
            <TabStripItem Content="Video" />
            <TabStripItem Content="Audio" />
        </TabStrip>
        <Grid ColumnDefinitions="270,*">
            <DockPanel Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,6,*,6,*">
                        <Button Content="Add" HorizontalAlignment="Stretch" Command="{Binding AddCommand}" />
                        <Button Grid.Column="2" Content="Duplicate" HorizontalAlignment="Stretch" Command="{Binding DuplicateCommand}" />
                        <Button Grid.Column="4" Content="Delete" HorizontalAlignment="Stretch" Command="{Binding DeleteCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,6,Auto,6,Auto">
                        <Button Content="Restore built-in presets" HorizontalAlignment="Stretch" Command="{Binding RestoreBuiltInsCommand}" />
                        <Button Grid.Column="2" Classes="move" ToolTip.Tip="Move up" Command="{Binding MoveUpCommand}">
                            <PathIcon Data="{StaticResource IconArrowUp}" />
                        </Button>
                        <Button Grid.Column="4" Classes="move" ToolTip.Tip="Move down" Command="{Binding MoveDownCommand}">
                            <PathIcon Data="{StaticResource IconArrowDown}" />
                        </Button>
                    </Grid>
                </StackPanel>
                <Border Classes="panel">
                    <Panel>
                        <ListBox x:Name="PresetList" ItemsSource="{Binding Presets}" SelectedItem="{Binding ListSelection}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="model:Preset">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Arguments}" Classes="dim" TextTrimming="CharacterEllipsis" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Where a dragged preset will land. -->
                        <Border x:Name="DropLine" Height="2" VerticalAlignment="Top" IsVisible="False" IsHitTestVisible="False"
                                Background="{DynamicResource SystemControlHighlightAccentBrush}" />
                    </Panel>
                </Border>
            </DockPanel>

            <ScrollViewer Grid.Column="1" IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Name" Classes="title" />
                    <TextBox Text="{Binding Name}" />
                    <TextBlock Text="ffmpeg output options" Classes="title" />
                    <TextBox x:Name="ArgumentsBox" Text="{Binding Arguments}" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="60"
                             FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace" FontSize="12"
                             PlaceholderText="{Binding ArgumentsPlaceholder}" />
                    <TextBlock Classes="dim" TextWrapping="Wrap"
                               Text="{Binding ArgumentsHelp}" />
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Spacing="6">
                            <TextBlock Text="File extension" Classes="title" />
                            <AutoCompleteBox Text="{Binding Extension}" ItemsSource="{Binding ExtensionSuggestions}" FilterMode="StartsWith"
                                             PlaceholderText="{Binding ExtensionPlaceholder}" MinimumPrefixLength="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Audio when copying isn't possible" Classes="title" />
                            <TextBox Text="{Binding AudioFallback}" FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Border Classes="panel" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="What this preset does" Classes="title" />
                            <TextBlock Text="{Binding Analysis}" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AccentWarnBrush}"
                                       IsVisible="{Binding Warnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                    <DockPanel>
                        <!-- macOS only: the preset in Finder's right-click menu, under Quick Actions. -->
                        <Button DockPanel.Dock="Left" Content="{Binding QuickActionText}" Command="{Binding ToggleQuickActionCommand}"
                                IsVisible="{Binding HasQuickActions}" ToolTip.Tip="{Binding QuickActionHint}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Revert" Command="{Binding RevertCommand}" />
                            <Button Classes="accent save" Command="{Binding SaveCommand}">
                                <!-- Both labels are always laid out (one hidden by opacity), so the width doesn't change with the state. -->
                                <Panel>
                                    <TextBlock Classes="unsaved" Text="Save preset" HorizontalAlignment="Center" />
                                    <TextBlock Classes="saved" Text="Preset saved" HorizontalAlignment="Center" />
                                </Panel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
